{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pharmaflow",

  // Keep this current. Older dates change what APIs are available.
  "compatibility_date": "2026-09-28",

  // Required. Without it, any dependency that touches `node:crypto`, `buffer`
  // or `path` fails at runtime with a confusing module-resolution error.
  "compatibility_flags": ["nodejs_compat"],

  // TanStack Start's server entrypoint. The Vite plugin resolves this and emits
  // a deploy-ready config at dist/server/wrangler.json during `vite build`.
  "main": "@tanstack/react-start/server-entry",

  "observability": {
    "enabled": true
  },

  // ---------------------------------------------------------------------------
  // Not wired yet. Uncomment and run the wrangler command once the account
  // exists. Left as documentation rather than empty arrays, because an empty
  // binding is silently ignored and looks like it is configured.
  //
  //   bunx wrangler d1 create pharmaflow      # then paste the id below
  //   bunx wrangler secret put GEMINI_API_KEY
  //
  // "vars" are public and end up in the client bundle. Anything secret goes in
  // `wrangler secret put`, never here.
  //
  // vars: {
  //   PUBLIC_SUPABASE_URL: "https://xxxx.supabase.co",
  //   PUBLIC_SUPABASE_ANON_KEY: "",
  //   PUBLIC_DEMO_MODE: "false"
  // },
  //
  // d1_databases: [
  //   { binding = "DB", database_name = "pharmaflow", database_id = "<paste>" }
  // ],
  //
  // For Postgres over the network instead of D1, Hyperdrive keeps the
  // connection pooled across requests:
  //
  // hyperdrive: [
  //   { binding = "HYPERDRIVE", id = "<paste>" }
  // ]
  // ---------------------------------------------------------------------------

  // =========================================================================
  // STAGING ENVIRONMENT
  // =========================================================================
  //
  // Prepared, NOT deployed. Nothing here changes production: the top-level
  // config above is untouched, and `wrangler deploy` with no `--env` ignores
  // this block entirely.
  //
  // `name`, `main`, `compatibility_date` and `compatibility_flags` do NOT
  // inherit into an environment in Wrangler, so they are repeated. Getting that
  // wrong is the usual cause of "env staging behaves differently from
  // production" surprises.
  //
  // Before deploying this, fill in the two pieces that are deliberately absent:
  //
  //   1. `vars` below. These are PUBLIC and land in the client bundle, so they
  //      must be staging publishable values only - never the service-role key.
  //
  //      bun x vite build --mode staging      (reads .env.staging)
  //
  //   2. Secrets, which are NOT vars and must never be added as ones:
  //
  //      bunx wrangler secret put SUPABASE_SERVICE_ROLE_KEY --env staging
  //      bunx wrangler secret put RESEND_API_KEY           --env staging
  //      bunx wrangler secret put RESEND_FROM             --env staging
  //      bunx wrangler secret put PUBLIC_APP_URL          --env staging
  //
  // `wrangler secret put` reads the value from stdin, so it does not land in
  // shell history. Use `--env staging`, or you will write to production.
  //
  // Deploy, once approved:
  //   bun x vite build --mode staging
  //   bunx wrangler deploy -c dist/server/wrangler.json --env staging
  //
  "env": {
    "staging": {
      "name": "pharmaflow-staging",
      "main": "@cloudflare/react-start/server-entry",
      "compatibility_date": "2026-09-28",
      "compatibility_flags": ["nodejs_compat"],
      "observability": { "enabled": true }

      // vars: {
      //   PUBLIC_SUPABASE_URL: "https://<staging-ref>.supabase.co",
      //   PUBLIC_SUPABASE_ANON_KEY: "",
      //   PUBLIC_DEMO_MODE: "false"
      // },
    },
    "demo": {
      "name": "pharmaflow-demo",
      "main": "@cloudflare/react-start/server-entry",
      "compatibility_date": "2026-09-28",
      "compatibility_flags": ["nodejs_compat"],
      "observability": { "enabled": true }
    }
  }
}