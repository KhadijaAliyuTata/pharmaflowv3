# Public variables. Safe to expose in the browser bundle — these are not secrets.
# The anon key is protected by Row Level Security, not by being hidden.

# Supabase project
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Set to "false" once real credentials exist above. While it is unset AND
# Supabase is unconfigured, the app runs in demo mode against seeded accounts
# so it is still clickable without a backend. The login screen says so.
PUBLIC_DEMO_MODE=true