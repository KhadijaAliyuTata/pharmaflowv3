# Public variables. Safe to expose in the browser bundle — these are not secrets.
# The anon key is protected by Row Level Security, not by being hidden.

# Supabase project
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Set to "false" once real credentials exist above. While it is unset AND
# Supabase is unconfigured, the app runs in demo mode against seeded accounts
# so it is still clickable without a backend. The login screen says so.
PUBLIC_DEMO_MODE=true

# The address a staff member's browser should open, used to build the join link
# in an invitation ("Copy link"). It has to be the pharmacy's real address,
# because the person opening the link is on their own phone: `localhost` names
# the reader's device, so a link built from a local browser is dead on arrival.
#
# Set this in a deployment. It is a public value, like the variables above, and
# is safe in the browser bundle. Never put a secret here - everything with the
# PUBLIC_ prefix ships to the client.
#
# Leave it unset on a local development server and the app falls back to the
# browser's own origin, which is the right answer for that machine.
PUBLIC_APP_URL=https://pharmaflow.ng